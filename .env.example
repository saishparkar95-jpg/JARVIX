# ===================================================================
# JARVIS AI - Environment Configuration
# ===================================================================

# AI Brain Configuration
# You can get an OpenAI API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Voice Settings
JARVIS_VOICE_RATE=175
JARVIS_VOICE_VOLUME=1.0
JARVIS_VOICE_GENDER=male

# Assistant Settings
ASSISTANT_NAME=JARVIS
USER_NAME=Sir
INPUT_MODE=voice

# Safety Settings
SAFE_MODE=true
REQUIRE_CONFIRMATION=true
